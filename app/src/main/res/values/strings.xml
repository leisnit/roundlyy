    <!-- Onboarding -->
    <string name="onboarding_1_title">Calm, precise interval alarms</string>
    <string name="onboarding_1_text">Fixed intervals, irregular reminders, stepped schedules and timers. Everything stays on this device: no account, no internet.</string>
    <string name="onboarding_2_title">Alerts you can rely on</string>
    <string name="onboarding_2_text">Roundly uses exact alarms and a full-screen alert, even when your phone is locked. Allow notifications so alerts can appear.</string>
    <string name="onboarding_3_title">Keep every alert on time</string>
    <string name="onboarding_3_text">Some phones pause apps to save battery. If an alert is ever late, open Settings, then Permissions health.</string>
