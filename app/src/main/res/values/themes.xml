<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only. All UI is drawn by Compose (see ui/theme/Theme.kt). -->
    <style name="Theme.Roundly" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Roundly.Alert">
        <item name="android:windowBackground">@color/window_background_alert</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">false</item>
    </style>
</resources>
